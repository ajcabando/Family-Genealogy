# PostgreSQL connection used by the app and Prisma CLI
DATABASE_URL=postgresql://family:family@db:5432/family_archive

# PostgreSQL password (must match POSTGRES_PASSWORD above if changed)
POSTGRES_PASSWORD=family

# Secret used to sign session JWTs (must be at least 32 chars, unique per deployment)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Initial administrator account (required, no default)
FAMILY_ADMIN_EMAIL=admin@family.local
FAMILY_ADMIN_PASSWORD=ChangeThisPassword123!

# Where uploaded images are stored (volume mount in docker-compose)
UPLOAD_DIR=/data/uploads

# Base URL used for links in emails/notifications
APP_URL=http://localhost:3844
