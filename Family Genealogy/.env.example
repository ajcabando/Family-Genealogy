# PostgreSQL connection used by the app and Prisma CLI
DATABASE_URL=postgresql://family:family@db:5432/family_archive

# Secret used to sign session JWTs (must be at least 32 chars)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Initial administrator account created by the seed script
FAMILY_ADMIN_EMAIL=admin@family.local
FAMILY_ADMIN_PASSWORD=FamilyAdmin123!

# Where uploaded images are stored (volume mount in docker-compose)
UPLOAD_DIR=/data/uploads

# Base URL used for links in emails/notifications (no email sending in MVP)
APP_URL=http://localhost:3844